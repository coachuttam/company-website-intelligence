  "cards": [
    {
      "dot": "amber",
      "title": "Not a rule-based extractor",
      "items": [
        "All 15 fields come from one gpt-4o-mini call guided by numbered prompt rules (wi/extract/prompt.py)",
        "Deterministic code only cleans text, checks evidence and gates the Jev answer",
        "traditional_crawler/ is a standalone crawler, not imported by wi/ or run_site.py"
      ]
    },
    {
      "dot": "cyan",
      "title": "Two kinds of caching",
      "items": [
        "Crawl de-dup: a page whose content hash was already kept is dropped",
        "Run cache: whole-site fingerprint of page text + prompt, schema, model and logic versions"
      ]
    },
    {
      "dot": "violet",
      "title": "Optional steps",
      "items": [
        "Focus retry (B-71) runs after extraction but focus_retry.enabled is false",
        "python -m wi.render turns a run JSON into an HTML profile page with coverage, pages-used and news-timeline charts, or a PDF with --pdf",
        "run_site.py --news (off by default) writes the company's own news to data/news/<slug>.json; GDELT can only mark possible coverage, never verified"
      ]
    }
  ]
}